# Sea Level Dashboard — FRONTEND build variables (frontend/.env.local). Never put secrets here:
# every REACT_APP_* value is compiled into the public JavaScript bundle.

# API location: unset = http://127.0.0.1:30886 (dev) · "" = same origin (AWS/CloudFront) · or a URL
REACT_APP_API_URL=http://127.0.0.1:30886

# Authentication: cognito (default) | disabled (local development / legacy on-prem only)
REACT_APP_AUTH_MODE=cognito
REACT_APP_COGNITO_DOMAIN=https://mapi-sealevel-dev.auth.il-central-1.amazoncognito.com
REACT_APP_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_COGNITO_IDP=Google

# Calibration has no frontend secret any more: the API grants it to verified admins only
# (ADMIN_EMAILS on the backend). See backend/.env.example.
