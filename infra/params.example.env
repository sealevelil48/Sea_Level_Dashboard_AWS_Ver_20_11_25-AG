# Copy to infra/params.<env>.env (git-ignored) and fill in. No secrets here — only names/ARNs.
AWS_REGION=il-central-1
VPC_ID=vpc-xxxxxxxx
PRIVATE_SUBNET_IDS=subnet-aaaa,subnet-bbbb          # private, with NAT + route to on-prem
ONPREM_CIDR=10.10.0.0/24                             # on-prem PostgreSQL network (over VPN)
ONPREM_SECRET_ARN=arn:aws:secretsmanager:il-central-1:123456789012:secret:sealevel/onprem-readonly-XXXX
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_NAME=sealevel/google-oauth-client-secret
COGNITO_DOMAIN_PREFIX=mapi-sealevel-dev
ADMIN_EMAILS=benp@mapi.gov.il
ALLOWED_USERS=mapi.gov.il                            # add client domains/addresses later in SSM
ALARM_EMAIL=benp@mapi.gov.il
