# Sea Level Dashboard — BACKEND (backend/.env) for local development and the on-prem server.
# On AWS these come from the CloudFormation stack and Secrets Manager instead.

DB_URI=postgresql+psycopg2://USER:PASSWORD@localhost:5432/sealevel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
BACKEND_PORT=30886
HOST=0.0.0.0

# --- Authentication --------------------------------------------------------------
# cognito: every /api route needs a Google sign-in via the Cognito user pool (same pool as AWS).
AUTH_MODE=cognito
COGNITO_REGION=il-central-1
COGNITO_USER_POOL_ID=il-central-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_EMAILS=benp@mapi.gov.il        # only these verified accounts can calibrate

# disabled: no sign-in (local development only). Calibration stays LOCKED unless the next line is
# true — never set it on a server reachable by others.
# AUTH_MODE=disabled
# ALLOW_INSECURE_LOCAL_CALIBRATION=false

# Comma-separated; leave empty when the frontend is served from the same origin.
CORS_ORIGINS=http://localhost:30887
ENABLE_DOCS=false
